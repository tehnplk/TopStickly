{
  "name": "topstickly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "productName": "TopStickly",
  "description": "HOSxP top bar",
  "author": "tehnplk",
  "repository": "github:tehnplk/TopStickly",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.tehnplk.topstickly",
    "productName": "TopStickly",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*"],
    "asar": false,
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": { "oneClick": true, "perMachine": false },
    "publish": { "provider": "github", "owner": "tehnplk", "repo": "TopStickly" }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.7",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.6"
  }
}
